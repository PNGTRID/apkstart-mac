{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "apkstart-mac",
  "version": "0.1.0",
  "identifier": "com.apkstart.mac",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ApkStart for Mac",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["apk", "xapk", "apks"],
        "name": "ApkStart 安卓安装包",
        "description": "双击即装：ApkStart for Mac 接管的安卓应用安装包",
        "mimeType": "application/vnd.android.package-archive"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["apkstart"]
      }
    }
  }
}
